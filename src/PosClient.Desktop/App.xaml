<Application x:Class="PosClient.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PosClient.Desktop.Shared.Converters"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- WPF-UI theme + controls -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:StringToListConverter x:Key="StringToListConverter"/>
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
            <converters:InverseItemsExistsToVisibilty x:Key="InverseItemsExistsToVisibilty" />
            <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <!-- Images -->
            <BitmapImage x:Key="PlaceholderImage" UriSource="/Assets/placeholder.png" />

            <Style TargetType="{x:Type DatePickerTextBox}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <TextBox x:Name="PART_TextBox" 
                             Text="{Binding Path=SelectedDate, 
                                            StringFormat='dd/MM/yyyy', 
                                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
