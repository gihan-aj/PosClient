<Application x:Class="PosClient.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PosClient.Desktop.Shared.Converters"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- WPF-UI theme + controls -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:StringToListConverter x:Key="StringToListConverter"/>
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
            <converters:InverseItemsExistsToVisibilty x:Key="InverseItemsExistsToVisibilty" />
            <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
            <!-- Images -->
            <BitmapImage x:Key="PlaceholderImage" UriSource="/Assets/placeholder.png" />

            <Style x:Key="GridHeaderLeft"
                   TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="GridHeaderCenter"
                   TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GridHeaderRight"
                   TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
