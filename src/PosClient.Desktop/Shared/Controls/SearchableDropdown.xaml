<UserControl x:Class="PosClient.Desktop.Shared.Controls.SearchableDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PosClient.Desktop.Shared.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             Name="RootControl">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        
        <!-- Search Box-->
        <ui:TextBox x:Name="SearchBox"
                    PlaceholderText="{Binding PlaceholderText, ElementName=RootControl}"
                    Text="{Binding SearchText, ElementName=RootControl, UpdateSourceTrigger=PropertyChanged}"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    GotFocus="SearchBox_GotFocus"
                    LostFocus="SearchBox_LostFocus"
                    TextChanged="SearchBox_TextChanged"
                    PreviewKeyDown="SearchBox_PreviewKeyDown"
                    PreviewMouseDown="SearchBox_PreviewMouseDown"/>
        
        <!-- Popup -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom"
               VerticalOffset="5"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">

            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="5"
                    Width="{Binding ActualWidth, ElementName=SearchBox}"
                    MaxHeight="250">

                <Grid>
                    
                    <!-- List View -->
                    <ui:ListView x:Name="ResultsList"
                                 ItemsSource="{Binding ItemsSource, ElementName=RootControl}"
                                 SelectedItem="{Binding SelectedItem, ElementName=RootControl, Mode=TwoWay}"
                                 ItemTemplate="{Binding ItemTemplate, ElementName=RootControl}"
                                 ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 BorderThickness="0"
                                 MaxHeight="240">
                        
                        <!-- No Results Message -->
                        <ui:TextBlock Text="No results found."
                                      Visibility="{Binding ShowNoResults, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Opacity="0.6"
                                      Margin="10"
                                      IsHitTestVisible="False"/>
                        
                        <!-- Loading Spinner -->
                        <ui:ProgressRing IsIndeterminate="True"
                                         Visibility="{Binding IsLoading, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Width="20" Height="20"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="0,5,15,0"
                                         IsHitTestVisible="False"/>

                    </ui:ListView>
                    
                </Grid>
                
            </Border>
            
        </Popup>

    </Grid>
</UserControl>
