<Page x:Class="PosClient.Desktop.Features.Orders.Creator.OrderCreatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.Creator"
      mc:Ignorable="d" 
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:OrderCreatorViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="OrderCreatorPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--Header-->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions >

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" 
                           Appearance="Transparent" 
                           Margin="0,0,10,0"/>
                <TextBlock Text="Create New Order" FontSize="24" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" 
                           Appearance="Secondary" 
                           Command="{Binding ViewModel.CancelCommand}" 
                           Width="80" Margin="0,0,10,0"/>
                <ui:Button Content="Save Order" 
                           Appearance="Primary" 
                           Icon="{ui:SymbolIcon Save24}" 
                           Command="{Binding ViewModel.SaveOrderCommand}" 
                           Width="120"/>
            </StackPanel>

        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <!-- Left: Customer (33%) -->
                <ColumnDefinition Width="15"/>
                <!-- Gutter -->
                <ColumnDefinition Width="2*"/>
                <!-- Right: Items & Details (66%) -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Customer & Delivery -->
            <ui:Card VerticalAlignment="Top" Grid.Column="0">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Person24" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBlock Text="Customer Information" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

            </ui:Card>

        </Grid>

    </Grid>
</Page>
