<ui:ContentDialog x:Class="PosClient.Desktop.Features.Orders.Creator.CreateCustomerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.Creator"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:CreateCustomerViewModel}"
             Title="New Customer"
             CloseButtonText="Cancel">
    <Grid Width="400">
        <StackPanel>

            <Grid Margin="0,0,0,10">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Name -->
                <StackPanel Grid.Column="0">
                    <Label Content="Name *" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="NameBox" PlaceholderText="John Doe" 
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Grid.Column="2">
                    <Label Content="Phone *" Target="{Binding ElementName=PhoneBox}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="PhoneBox" PlaceholderText="077-..." 
                                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </Grid>

            <!-- Email -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="Email" Target="{Binding ElementName=EmailBox}" Padding="0,0,0,4"/>
                <ui:TextBox x:Name="EmailBox" PlaceholderText="customer@example.com" 
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Address -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="Address" Target="{Binding ElementName=AddressBox}" Padding="0,0,0,4"/>
                <ui:TextBox x:Name="AddressBox" PlaceholderText="123 Main Street" 
                            Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- City -->
                <StackPanel Grid.Column="0">
                    <Label Content="City" Target="{Binding ElementName=CityBox}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="CityBox" PlaceholderText="Colombo" 
                Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Country -->
                <StackPanel Grid.Column="2">
                    <Label Content="Country" Target="{Binding ElementName=Country}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="Country" PlaceholderText="Sri Lanka" 
                    Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </Grid>
            
            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Postal Code -->
                <StackPanel Grid.Column="0">
                    <Label Content="Postal Code" Target="{Binding ElementName=PostalCode}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="PostalCode" PlaceholderText="76950" 
                                Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Region -->
                <StackPanel Grid.Column="2">
                    <Label Content="Region" Target="{Binding ElementName=Region}" Padding="0,0,0,4"/>
                    <ui:TextBox x:Name="Region" PlaceholderText="Sabaragamuwa" 
                    Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </Grid>

            <!-- Notes -->
            <StackPanel Margin="0,0,0,10">
                <Label Content="Notes" Target="{Binding ElementName=Notes}" Padding="0,0,0,4"/>
                <ui:TextBox x:Name="Notes" PlaceholderText="e.g.: Delivery Instructions" 
                Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <ui:Button Command="{Binding SaveCommand}" 
                       Content="Create Customer" 
                       Appearance="Primary" 
                       HorizontalAlignment="Stretch" 
                       Margin="0,10,0,0"/>

        </StackPanel>

        <!-- Loading Overlay (Sits on top of the StackPanel) -->
        <Grid Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisConverter}}"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              Opacity="0.8"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="Saving..." VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</ui:ContentDialog>
