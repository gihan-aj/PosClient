<ui:ContentDialog x:Class="PosClient.Desktop.Features.Orders.Creator.AddOrderItem.AddOrderItemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.Creator.AddOrderItem"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:AddOrderItemViewModel}"
             Title="Add Products"
             CloseButtonText="Close"
             DefaultButton="Close"  >
    <Grid Width="900" Height="560">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" 
                      ItemsSource="{Binding SearchInOptions}"
                      SelectedItem="{Binding SelectedSearchIn}"
                      Margin="0,0,10,0" HorizontalAlignment="Stretch"/>

            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Search by Name, SKU, or Color..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        Margin="0,0,10,0">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <ui:Button Grid.Column="2" 
                       Command="{Binding SearchCommand}" 
                       Content="Search" 
                       Appearance="Primary" 
                       Icon="{ui:SymbolIcon Search24}"/>

        </Grid>
        
        <!-- Results grid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding SearchResults}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  HorizontalScrollBarVisibility="Auto"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ControlElevationBorderBrush}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Data.Sku}" Width="160"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Data.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Data.Color}" Width="80"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Data.Size}" Width="60"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Data.CurrentStock}" Width="70"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Data.SellingPrice, StringFormat='Rs. {0:N2}'}" Width="80"/>

                <!-- Action Column -->
                <DataGridTemplateColumn Header="Add to Order" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                <ui:NumberBox Value="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" 
                                              Minimum="1" 
                                              Maximum="{Binding Data.CurrentStock}"
                                              SpinButtonPlacementMode="Compact"
                                              Width="80" Margin="0,0,5,0"
                                              VerticalAlignment="Center" />

                                <ui:Button Command="{Binding DataContext.AddToOrderCommand, RelativeSource={RelativeSource AncestorType=ui:ContentDialog}}" 
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Add24}"
                                            Height="36"
                                           VerticalAlignment="Center" >
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <!-- Feedback: Green Check if in cart -->
                                                <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                                    <Setter Property="Appearance" Value="Success"/>
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Checkmark24}"/>
                                                </DataTrigger>
                                                <!-- Disable if No Stock -->
                                                <DataTrigger Binding="{Binding Data.CurrentStock}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading -->
        <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                         Width="50" Height="50"/>

        <Grid Grid.Row="1" 
              Visibility="{Binding IsEmptyResults, Converter={StaticResource BoolToVisConverter}}"
              IsHitTestVisible="False">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="5"
                    Opacity="0.8">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">

                    <ui:SymbolIcon Symbol="SearchInfo24" 
                                   FontSize="64" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,20"/>

                    <TextBlock Text="No products found" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Try different search or filters to find what you're looking for." 
                               FontSize="14" 
                               Margin="0,10,0,20"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                </StackPanel>

            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows per page:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0" 
                   Foreground="Gray"/>

                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                  SelectedItem="{Binding PageSize}"
                  Width="70">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ChangePageSizeCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold"/>
                <TextBlock Text=" items found" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" 
                   Command="{Binding PreviousPageCommand}"
                   IsEnabled="{Binding HasPreviousPage}"
                   Appearance="Secondary"
                   ToolTip="Previous Page"/>

                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>

                    <ui:TextBox x:Name="PageInput"
                        Text="{Binding CurrentPage, UpdateSourceTrigger=LostFocus}"
                        Width="70" 
                        HorizontalContentAlignment="Center">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" 
                                Command="{Binding JumpToPageCommand}"
                                CommandParameter="{Binding Text, ElementName=PageInput}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <TextBlock Text="of" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" 
                   Command="{Binding NextPageCommand}"
                   IsEnabled="{Binding HasNextPage}"
                   Appearance="Secondary"
                   ToolTip="Next Page"/>
            </StackPanel>
        </Grid>

    </Grid>
</ui:ContentDialog>
