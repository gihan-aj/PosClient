<UserControl x:Class="PosClient.Desktop.Features.Orders.Details.Customer.CustomerSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.Details.Customer"
             xmlns:parent="clr-namespace:PosClient.Desktop.Features.Orders.Details"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=parent:OrderDetailsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        
        <!-- Search Box -->
        <ui:TextBox x:Name="CustomerSearchBox"
                    PlaceholderText="Search customer (name, phone or email)"
                    Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    GotFocus="CustomerSearchBox_GotFocus"
                    LostFocus="CustomerSearchBox_LostFocus"
                    TextChanged="CustomerSearchBox_TextChanged"
                    PreviewKeyDown="CustomerSearchBox_PreviewKeyDown"
                    PreviewMouseDown="CustomerSearchBox_PreviewMouseDown"/>
        
        <!-- Dropdown Popup-->
        <Popup x:Name="CustomerResultsPopup"
               PlacementTarget="{Binding ElementName=CustomerSearchBox}"
               Placement="Bottom"
               VerticalOffset="5"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">

            <Border CornerRadius="8"
                    BorderThickness="1"
                    Padding="8"
                    Width="{Binding ActualWidth, ElementName=CustomerSearchBox}"
                    MaxHeight="250"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">

                <Grid>

                    <!-- The Results List -->
                    <ui:ListView x:Name="ResultsList"
                                 ItemsSource="{Binding CustomerSearchResults}"
                                 SelectedItem="{Binding SelectedCustomer}"
                                 ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 BorderThickness="0">

                        <ui:ListView.ItemTemplate>
                            <DataTemplate>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Symbol="Person24"
                                                   FontSize="20"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Address}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                </Grid>

                            </DataTemplate>
                        </ui:ListView.ItemTemplate>

                    </ui:ListView>

                    <!-- No Results Message -->
                    <ui:TextBlock Text="No customers found."
                                  Visibility="{Binding ShowNoCustomersFound, Converter={StaticResource BoolToVisConverter}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Opacity="0.6"
                                  Margin="10,50"
                                  IsHitTestVisible="False"/>

                    <!-- Loading Indicator -->
                    <ui:ProgressRing IsIndeterminate="True"
                                     Visibility="{Binding IsCustomersLoading, Converter={StaticResource BoolToVisConverter}}"
                                     Width="30" Height="30"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Margin="0,50"
                                     IsHitTestVisible="False"/>

                </Grid>

            </Border>

        </Popup>

    </Grid>
</UserControl>
