<Page x:Class="PosClient.Desktop.Features.Orders.Details.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.Details"
      xmlns:customer="clr-namespace:PosClient.Desktop.Features.Orders.Details.Customer"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:OrderDetailsViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="OrderDetailsPage">

    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                           Command="{Binding NavigateBackCommand}"
                           Appearance="Transparent" Margin="0,0,10,0"/>
                <ui:TextBlock Text="{Binding PageTitle}"
                              Style="{StaticResource TitleTextBlockStyle}"
                              VerticalAlignment="Center"/>

                <!-- Status Badge (Header Context) -->
                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#15888888"/>
                            <!-- Default -->
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Confirmed">
                                    <Setter Property="Background" Value="#150078D4"/>
                                    <Setter Property="TextBlock.Foreground" Value="#FF0078D4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Processing">
                                    <Setter Property="Background" Value="#158764B8"/>
                                    <Setter Property="TextBlock.Foreground" Value="#FF8764B8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Shipped">
                                    <Setter Property="Background" Value="#15107C10"/>
                                    <Setter Property="TextBlock.Foreground" Value="#FF107C10"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Cancelled">
                                    <Setter Property="Background" Value="#15E81123"/>
                                    <Setter Property="TextBlock.Foreground" Value="#FFE81123"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CurrentOrderStatus}" FontSize="12" FontWeight="SemiBold"/>
                </Border>

            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <!--<ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Command="{Binding CancelCommand}"
                           MinWidth="100" Margin="0,0,10,0"/>-->
                <!-- Save Draft (Always visible for editable orders) -->
                <ui:Button Content="Save Changes"
                           Appearance="Secondary" Margin="0,0,10,0"
                           Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding SaveCommand}"
                           MinWidth="100"/>

                <!-- 1. Confirm (Visible if Pending) -->
                <ui:Button Content="Confirm Order" 
                           Appearance="Primary" 
                           Icon="{ui:SymbolIcon Checkmark24}" 
                           Command="{Binding ConfirmOrderCommand}" 
                           MinWidth="120">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Pending">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <!-- 2. Start Processing (Visible if Confirmed) -->
                <ui:Button Content="Start Processing" 
                           Appearance="Primary" 
                           Icon="{ui:SymbolIcon ArrowRight24}" 
                           Command="{Binding StartProcessingCommand}" 
                           MinWidth="120">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Confirmed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <!-- 3. Ship Order (Visible if Processing) -->
                <ui:Button Content="Ship Order" 
                           Appearance="Primary" 
                           Icon="{ui:SymbolIcon VehicleTruckProfile24}" 
                           Command="{Binding ShipOrderCommand}" 
                           MinWidth="120">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentOrderStatus}" Value="Processing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

            </StackPanel>

        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MaxWidth="400"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0">

                <!-- Customer Card -->
                <Border BorderThickness="1"
                        CornerRadius="8" Padding="10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Margin="0,0,0,10">

                    <StackPanel>
                        
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Person24" FontSize="20" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="Customer Information"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <!-- Customer search -->
                        <customer:CustomerSearchControl Margin="0,0,0,10" />

                        <!-- Selected Customer View -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,0,0,0"
                                Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel>

                                <!-- Header: Avatar + Name -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="32" 
                                                   Foreground="{DynamicResource SystemAccentColorBrush}" 
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCustomer.Name}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Customer" FontSize="11" Opacity="0.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Details Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <!-- Icon Column -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Phone -->
                                    <ui:SymbolIcon Grid.Row="0" Symbol="Call24" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomer.PhoneNumber}" Margin="10,0,0,8"/>

                                    <!-- Email (Optional: Shows only if exists) -->
                                    <ui:SymbolIcon Grid.Row="1" Symbol="Mail24" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer.Email, TargetNullValue='-'}" Margin="10,0,0,8"/>

                                    <!-- Address Group -->
                                    <ui:SymbolIcon Grid.Row="2" Symbol="Location24" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                                        <!-- Main Address Line -->
                                        <TextBlock Text="{Binding SelectedCustomer.Address}" TextWrapping="Wrap" FontWeight="SemiBold"/>

                                        <!-- City, Region, Zip Line -->
                                        <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}, {1} {2}">
                                                    <Binding Path="SelectedCustomer.City" FallbackValue="" TargetNullValue=""/>
                                                    <Binding Path="SelectedCustomer.Region" FallbackValue="" TargetNullValue=""/>
                                                    <Binding Path="SelectedCustomer.PostalCode" FallbackValue="" TargetNullValue=""/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- Country -->
                                        <TextBlock Text="{Binding SelectedCustomer.Country}" Opacity="0.6" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Actions -->
                                <ui:HyperlinkButton Content="View Order History" Icon="{ui:SymbolIcon History24}" Margin="-6,10,0,0" />
                            </StackPanel>
                        </Border>

                        <ui:Button Content="New Customer" 
                                   Command="{Binding OpenNewCustomerDialogCommand}"
                                   Icon="{ui:SymbolIcon Add24}" 
                                   Appearance="Secondary" 
                                   HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                   Visibility="{Binding SelectedCustomer, Converter={StaticResource InverseNullToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    </StackPanel>
                    
                </Border>

                <!-- Delivery -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                            <ui:SymbolIcon Symbol="VehicleTruckProfile24" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Delivery Details" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Toggle -->
                        <CheckBox Content="Same as customer address" 
                                  IsChecked="{Binding IsDeliverySameAsCustomer, Mode=TwoWay}" 
                                  Margin="0,0,0,5"/>

                        <!-- Conditional delivery form -->
                        <StackPanel Visibility="{Binding IsDeliverySameAsCustomer, Converter={StaticResource InverseBoolToVisConverter}}">

                            <!-- Custom Delivery Fields -->
                            <StackPanel Margin="0,0,0,10">
                                <Label Content="Address" Target="{Binding ElementName=DelAddressBox}" Padding="0,0,0,4"/>
                                <ui:TextBox x:Name="DelAddressBox" PlaceholderText="123 Main Street" 
                                            Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="City" Target="{Binding ElementName=DelCityBox}" Padding="0,0,0,4"/>
                                    <ui:TextBox x:Name="DelCityBox" PlaceholderText="Colombo" 
                                                Text="{Binding DeliveryCity, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Country" Target="{Binding ElementName=DelCountry}" Padding="0,0,0,4"/>
                                    <ui:TextBox x:Name="DelCountry" PlaceholderText="Sri Lanka" 
                                                Text="{Binding DeliveryCountry, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Postal Code" Target="{Binding ElementName=DelPostal}" Padding="0,0,0,4"/>
                                    <ui:TextBox x:Name="DelPostal" PlaceholderText="76950" 
                                                Text="{Binding DeliveryPostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Region" Target="{Binding ElementName=DelRegion}" Padding="0,0,0,4"/>
                                    <ui:TextBox x:Name="DelRegion" PlaceholderText="Western" 
                                                Text="{Binding DeliveryRegion, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                        <!-- Courier Service -->
                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Courier Service"  Target="{Binding ElementName=CourierCombobox}" Padding="0,0,0,4"/>
                            <!--<ComboBox x:Name="CourierCombobox" 
                                      SelectedIndex="{Binding SelectedCourierIndex}">
                                <ComboBoxItem Content="Pick Up"/>
                                <ComboBoxItem Content="Local Courier"/>
                                <ComboBoxItem Content="DHL Express"/>
                            </ComboBox>-->
                            <ComboBox x:Name="CourierCombobox" 
                                      ItemsSource="{Binding Couriers}"
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding CourierId}"
                                      ToolTip="Select the Courier"
                                      Margin="0,0,10,0">
                            </ComboBox>
                        </StackPanel>

                        <!-- Tracking Number -->
                        <StackPanel Visibility="{Binding IsCreatingNewOrder, Converter={StaticResource InverseBoolToVisConverter}}" Margin="0,0,0,0">
                            <Label Content="Tracking Number" Target="{Binding ElementName=TrackingNumber}" Padding="0,0,0,4"/>
                            <ui:TextBox x:Name="TrackingNumber" 
                                        PlaceholderText="e.g. TRK-990022"
                                        Text="{Binding TrackingNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>


                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10" Margin="0,0,0,10">

                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                            <ui:SymbolIcon Symbol="WalletCreditCard24" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Payment Details" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Payment Summary Grid -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Paid Amount -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Paid Amount" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding PaidAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" FontSize="16"/>
                            </StackPanel>

                            <!-- Balance Due -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Balance Due" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding BalanceDue, StringFormat='Rs. {0:N2}'}" 
                                           FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Add Initial Payment (Button) -->
                        <ui:Button Content="Add Initial Payment" 
                                   Icon="{ui:SymbolIcon Add24}" 
                                   Appearance="Secondary" Margin="0,0,0,10"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding OpenAddPaymentDialogCommand}"/>

                        <!-- Status Badge -->
                        <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,10    ">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#15E81123"/>
                                    <!-- Default Red (Unpaid) -->
                                    <Setter Property="TextBlock.Foreground" Value="#FFE81123"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPaymentStatus}" Value="Partial">
                                            <Setter Property="Background" Value="#15FF8C00"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFF8C00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPaymentStatus}" Value="Paid">
                                            <Setter Property="Background" Value="#15107C10"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF107C10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedPaymentStatus}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>

                    </StackPanel>
                    
                </Border>

            </StackPanel>
            
            <!-- Right Column -->
            <Grid Grid.Column="2">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Order Details -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10" Margin="0,0,0,10">

                    <StackPanel>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Order Details" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Order # -->
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="Order #" Appearance="Secondary" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Date -->
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Order Date" Appearance="Secondary" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat='MMM dd, yyyy'}" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                    
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10"
                        VerticalAlignment="Stretch">

                    <Grid>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Add Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Order Items" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:Button HorizontalAlignment="Right" 
                                       Icon="{ui:SymbolIcon Add24}" 
                                       Content="Add Item" Appearance="Primary"
                                       Command="{Binding OpenAddOrderItemsDialogCommand}"/>
                        </Grid>

                        <!-- Items Grid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding OrderItems}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Width="*" Binding="{Binding ProductName}"/>
                                <DataGridTextColumn Header="Variant" MinWidth="120" Width="Auto" Binding="{Binding Variant}"/>
                                <DataGridTextColumn Header="Price" MinWidth="100" Width="Auto" Binding="{Binding Price, StringFormat='Rs. {0:N2}'}"/>

                                <DataGridTemplateColumn Header="Qty" MinWidth="120" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:NumberBox Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                          Minimum="1" SmallChange="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Total" Width="100" Binding="{Binding Total, StringFormat='Rs. {0:N2}'}"/>

                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                       Foreground="IndianRed"
                                                       Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Financial Totals -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Width="250" Margin="0,16,0,0">
                            <Grid Margin="0,2">
                                <TextBlock Text="Subtotal"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='Rs. {0:N2}'}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Discount"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="- Rs." Foreground="#E04F5F" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ui:NumberBox Value="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" 
                                                  SmallChange="100" LargeChange="500"
                                                  SpinButtonPlacementMode="Compact"
                                                  Width="80"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Shipping Fee"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="+ Rs." Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ui:NumberBox Value="{Binding ShippingFee, UpdateSourceTrigger=PropertyChanged}" 
                                                  SmallChange="100" LargeChange="500"
                                                  SpinButtonPlacementMode="Compact"
                                                  Width="80"/>
                                </StackPanel>
                            </Grid>
                            <Separator Margin="0,8"/>
                            <Grid>
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                            </Grid>
                        </StackPanel>

                    </Grid>
                    
                </Border>

                <!-- Notes (Bottom) -->
                <Border Grid.Row="2" Margin="0,0,0,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10">
                    <StackPanel Grid.Column="2">
                        <Label Content="Notes" Target="{Binding ElementName=Notes}" Padding="0,0,0,4"/>
                        <ui:TextBox x:Name="Notes" 
                                    PlaceholderText="Customer special requests..." 
                                    AcceptsReturn="True" 
                                    Height="80" 
                                    TextWrapping="Wrap"
                                    Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

            </Grid>
            
        </Grid>
        
    </Grid>
</Page>
