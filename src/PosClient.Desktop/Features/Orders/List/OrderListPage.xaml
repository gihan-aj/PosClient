<Page x:Class="PosClient.Desktop.Features.Orders.List.OrderListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Orders.List"
      mc:Ignorable="d" 
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:OrderListViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="OrderListPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Grid Grid.Row="0" Margin="0, 0, 0, 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Orders" FontSize="24" FontWeight="SemiBold"/>

            <ui:Button Grid.Column="1"
                       Content="New Order"
                       Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary"
                       Command="{Binding ViewModel.NavigateToCreateCommand}"/>
        </Grid>

        <!-- ROW 1: Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" 
                            PlaceholderText="Search by Order #, Customer or City..." 
                            Text="{Binding ViewModel.Request.Search, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ViewModel.SearchCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:Button Grid.Column="1"
                           Height="36"
                           Icon="{ui:SymbolIcon Search24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.SearchCommand}"/>
            </Grid>

            <!-- Advanced Filters -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Status -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Payment -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Start Date -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- End Date -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Reset -->
                </Grid.ColumnDefinitions>

                <!-- Order Status -->
                <ComboBox Grid.Column="0" Width="140"
                          x:Name="OrderStatusCombo"
                          ItemsSource="{Binding ViewModel.StatusOptions}"
                          SelectedItem="{Binding ViewModel.Request.Status}"
                          Margin="0,0,10,0" ToolTip="Order Status">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ApplyFiltersCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>

                <TextBlock Grid.Column="0" Width="140"
                           Text="Order Status"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=OrderStatusCombo, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ElementName=OrderStatusCombo, Path=SelectedValue}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Payment Status -->
                <ComboBox x:Name="PaymentStatusCombo" 
                          Grid.Column="1" Width="140"
                          ItemsSource="{Binding ViewModel.PaymentStatusOptions}" 
                          SelectedItem="{Binding ViewModel.Request.PaymentStatus}"
                          Margin="0,0,10,0" ToolTip="Payment Status">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ApplyFiltersCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
                <TextBlock Grid.Column="1" Width="140"
                           Text="Payment Status"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PaymentStatusCombo, Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                    <!-- Start Date -->
                <DatePicker Grid.Column="2" Width="150"
                            x:Name="StartDatePicker"
                            SelectedDate="{Binding ViewModel.Request.StartDate}"
                            Margin="0,0,10,0" ToolTip="Start Date">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectedDateChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ApplyFiltersCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </DatePicker>

                <TextBlock Grid.Column="2" Width="150"
                           Text="Start Date"
                           Padding="10,0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=StartDatePicker, Path=SelectedDate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- End Date -->
                <DatePicker Grid.Column="3" Width="150"
                            x:Name="EndDatePicker"
                            SelectedDate="{Binding ViewModel.Request.EndDate}"
                            Margin="0,0,10,0" ToolTip="End Date">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectedDateChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ApplyFiltersCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </DatePicker>

                <TextBlock Grid.Column="3" Width="150"
                           Text="End Date"
                           Padding="10,0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=EndDatePicker, Path=SelectedDate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Reset -->
                <ui:Button Grid.Column="5"
                           Height="36"
                           Content="Reset Filters"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Appearance="Secondary"
                           Command="{Binding ViewModel.ClearFiltersCommand}"/>
            </Grid>
        </Grid>

        <!-- ROW 2: DataGrid -->
        <StackPanel Grid.Row="2">

            <ui:DataGrid ItemsSource="{Binding ViewModel.Orders}"
                         AutoGenerateColumns="False"
                         HeadersVisibility="Column"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         Sorting="DataGrid_Sorting"
                         ScrollViewer.CanContentScroll="True"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                         ColumnHeaderHeight="40"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=StackPanel}}">

                <ui:DataGrid.Columns>

                    <!-- Order Number & Date -->
                    <DataGridTemplateColumn Header="Order" 
                                            Width="*" MinWidth="150" 
                                            SortMemberPath="orderNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat=d}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Customer -->
                    <DataGridTemplateColumn Header="Customer" 
                                            Width="*" MinWidth="150" 
                                            SortMemberPath="customerName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DeliveryCity}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="Status" 
                                            Width="Auto" MinWidth="100"
                                            SortMemberPath="status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" 
                                        Padding="8,2" Margin="13,0,0,0"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#15888888"/>
                                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <!-- Confirmed (Blue) -->
                                                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                    <Setter Property="Background" Value="#150078D4"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FF0078D4"/>
                                                </DataTrigger>

                                                <!-- Shipped (Purple) -->
                                                <DataTrigger Binding="{Binding Status}" Value="Shipped">
                                                    <Setter Property="Background" Value="#158764B8"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FF8764B8"/>
                                                </DataTrigger>

                                                <!-- Delivered (Green) -->
                                                <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                    <Setter Property="Background" Value="#15107C10"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FF107C10"/>
                                                </DataTrigger>

                                                <!-- Cancelled (Red) -->
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#15E81123"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FFE81123"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}" FontSize="12"/>

                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Payment Badge -->
                    <DataGridTemplateColumn Header="Payment" MinWidth="100" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" 
                                        Padding="8,2" Margin="13,0,0,0"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Default (Unpaid - Red) -->
                                            <Setter Property="Background" Value="#15E81123"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFE81123"/>

                                            <Style.Triggers>
                                                <!-- Partial (Orange) -->
                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                    <Setter Property="Background" Value="#15FF8C00"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FFFF8C00"/>
                                                </DataTrigger>

                                                <!-- Paid (Green) -->
                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                    <Setter Property="Background" Value="#15107C10"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#FF107C10"/>
                                                </DataTrigger>

                                                <!-- Refunded (Gray) -->
                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Refunded">
                                                    <Setter Property="Background" Value="#15888888"/>
                                                    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PaymentStatus}" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Financials -->
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" MinWidth="80" Width="Auto"/>

                    <DataGridTextColumn Header="Total" 
                                        Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" 
                                        Width="Auto" MinWidth="120" FontWeight="SemiBold"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Width="Auto" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Orientation="Horizontal" Margin="13,0,0,0">
                                    <ui:Button Icon="{ui:SymbolIcon Eye24}"
                                               Appearance="Transparent"
                                               ToolTip="View Details"
                                               Command="{Binding DataContext.ViewModel.NavigateToDetailsCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.Row="2" 
              Background="{DynamicResource ApplicationBackgroundBrush}" 
              Opacity="0.8"
              Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ui:ProgressRing IsIndeterminate="True"/>
        </Grid>

        <!-- Empty State -->
        <Grid Grid.Row="2" 
              Visibility="{Binding ViewModel.IsEmptyResults, Converter={StaticResource BoolToVisConverter}}"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">
                <ui:SymbolIcon Symbol="SearchInfo24" FontSize="64" Foreground="Gray" Margin="0,0,0,20"/>
                <TextBlock Text="No orders found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ROW 3: Pagination -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>
                <ComboBox ItemsSource="{Binding ViewModel.PageSizeOptions}"
                          SelectedItem="{Binding ViewModel.PageSize}"
                          Width="70">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ChangePageSizeCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.TotalCount}" FontWeight="SemiBold"/>
                <TextBlock Text=" items found" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" 
                           Command="{Binding ViewModel.PreviousPageCommand}"
                           IsEnabled="{Binding ViewModel.HasPreviousPage}"
                           Appearance="Secondary"/>
                <TextBlock Text="{Binding ViewModel.CurrentPage}" Margin="10,0" VerticalAlignment="Center"/>
                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" 
                           Command="{Binding ViewModel.NextPageCommand}"
                           IsEnabled="{Binding ViewModel.HasNextPage}"
                           Appearance="Secondary"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
