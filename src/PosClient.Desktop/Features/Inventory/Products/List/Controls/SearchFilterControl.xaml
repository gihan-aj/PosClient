<UserControl x:Class="PosClient.Desktop.Features.Inventory.Products.List.Controls.SearchFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Inventory.Products.List.Controls"
             xmlns:parent="clr-namespace:PosClient.Desktop.Features.Inventory.Products.List"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance parent:ProductListViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,0,0,10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SearchScopeList}"
                      SelectedItem="{Binding Request.SearchIn}"
                      Width="110" Margin="0,0,10,0"
                      ToolTip="Search In Field" />

            <ui:TextBlock Grid.Column="0"
                          FontSize="14"
                          Text="Search in..."
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          Foreground="Gray"
                          IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedIndex}" Value="-1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedValue}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </ui:TextBlock>

            <ui:TextBox Grid.Column="1"
                        Margin="0,0,10,0"
                        PlaceholderText="Search products..." 
                        Text="{Binding Request.Search, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <ui:Button Grid.Column="2"
                       Height="36"
                       Icon="{ui:SymbolIcon Search24}"
                       Appearance="Primary"
                       Command="{Binding SearchCommand}"/>

        </Grid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CategoryCombo" 
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      Grid.Column="0" 
                      Width="250"
                      ItemsSource="{Binding DataContext.ViewModel.Categories}"
                      DisplayMemberPath="NamePath" 
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DataContext.Request.CategoryId}"
                      ToolTip="Filter by Category"
                      Margin="0,0,15,0">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding SearchCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ComboBox>
            
        </Grid>

        

    </Grid>
</UserControl>
