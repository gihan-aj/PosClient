<Page x:Class="PosClient.Desktop.Features.Inventory.Products.List.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Inventory.Products.List"
      mc:Ignorable="d" 
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:ProductListViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="ProductListPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0, 0, 0, 10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Products" FontSize="24" FontWeight="SemiBold"/>

            <ui:Button Grid.Column="1"
                       Content="New Product"
                       Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary"
                       Command="{Binding ViewModel.NavigateToAddCommand}"/>

        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="SearchInCombo" Grid.Column="0" 
                          ItemsSource="{Binding ViewModel.SearchScopeList}"
                          SelectedItem="{Binding ViewModel.Request.SearchIn}"
                          Width="110" Margin="0,0,10,0"
                          ToolTip="Search In Field"/>

                <TextBlock Text="Search In..."
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedValue}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ui:TextBox Grid.Column="1" 
                            PlaceholderText="Search products..." 
                            Text="{Binding ViewModel.Request.Search, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ViewModel.SearchCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:Button Grid.Column="2"
                           Height="36"
                           Icon="{ui:SymbolIcon Search24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.SearchCommand}"/>

            </Grid>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CategoryCombo" 
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Grid.Column="0" 
                          Width="250"
                          ItemsSource="{Binding ViewModel.Categories}"
                          DisplayMemberPath="NamePath" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ViewModel.Request.CategoryId}"
                          ToolTip="Filter by Category"
                          Margin="0,0,10,0">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.SearchCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>

                <TextBlock Text="Filter by Category"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=CategoryCombo, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ElementName=CategoryCombo, Path=SelectedValue}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox Grid.Column="1" 
                          Content="Include sub-categories" 
                          IsChecked="{Binding ViewModel.Request.IncludeSubCategories}"
                          Command="{Binding ViewModel.ApplyFilterCommand}"
                          IsEnabled="{Binding ViewModel.Request.CategoryId, Converter={StaticResource IsNotNullConverter}}"
                          VerticalAlignment="Center"/>

                <ComboBox Grid.Column="3"
                          Width="140"
                          ItemsSource="{Binding ViewModel.StatusOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding ViewModel.Request.IsActive}"
                          Margin="10,0,0,0">

                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.SearchCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>

                <ui:Button Grid.Column="4"
                           Height="36"
                           Content="Reset Filters"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Appearance="Secondary"
                           Command="{Binding ViewModel.ClearFiltersCommand}"/>

            </Grid>

        </Grid>

        <StackPanel Grid.Row="2" >
            <ui:DataGrid ItemsSource="{Binding ViewModel.Products}"
                         AutoGenerateColumns="False"
                         HeadersVisibility="Column"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         Sorting="DataGrid_Sorting"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                         ColumnHeaderHeight="40"
                         GridLinesVisibility="None"
                         Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">

                <ui:DataGrid.Columns>

                    <DataGridTemplateColumn Header="Image"
                                            Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="80" Height="80" CornerRadius="4"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <Binding Path="PrimaryImageUrl" Converter="{StaticResource ImagePathToBitmapConverter}"/>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Product" 
                                            Width="*" MinWidth="180"
                                            SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Base Price" 
                                        Binding="{Binding BasePrice, StringFormat='Rs. {0:N2}'}" 
                                        MinWidth="100" Width="Auto"/>

                    <DataGridTemplateColumn Header="Available Stock"
                                            Width="Auto" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding ActiveStock}" 
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding ActiveVariantCount, StringFormat='{}{0} variants'}" 
                                               FontSize="11" Foreground="Gray"/>
                                    <Border Background="{Binding StockStatusBar}" 
                                            Height="4" CornerRadius="2" Width="40" Margin="0,4,0,0" 
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Total Stock"
                                            Width="Auto" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding TotalStock}" 
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding VariantCount, StringFormat='{}{0} variants'}" 
                                               FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="IsActive">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#10FF0000"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#1000FF00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}" 
                                               FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Orientation="Horizontal" Margin="13,0,0,0">

                                    <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                               Appearance="Transparent" Margin="5,0"
                                               ToolTip="Edit"
                                               FontSize="16"
                                               Command="{Binding DataContext.ViewModel.EditProductCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}"/>

                                    <ui:Button Appearance="Transparent"
                                               ToolTip="Deactivate"
                                               Command="{Binding DataContext.ViewModel.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Margin="5,5,5,5">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="Prohibited24" FontSize="16" Foreground="Orange"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Appearance="Transparent"
                                               ToolTip="Activate"
                                               Command="{Binding DataContext.ViewModel.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Margin="5,5,5,5">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="ForestGreen"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </ui:DataGrid.Columns>

            </ui:DataGrid>
        </StackPanel>
        <Grid Grid.Row="2" 
              Background="{DynamicResource ApplicationBackgroundBrush}" 
              Opacity="0.8"
              Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ui:ProgressRing IsIndeterminate="True"/>
        </Grid>

        <Grid Grid.Row="2" 
              Visibility="{Binding ViewModel.IsEmptyResults, Converter={StaticResource BoolToVisConverter}}"
              IsHitTestVisible="False">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="5"
                    Opacity="0.8">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">

                    <ui:SymbolIcon Symbol="SearchInfo24" 
                                   FontSize="64" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,20"/>

                    <TextBlock Text="No products found" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Try adjusting your search or filters to find what you're looking for." 
                               FontSize="14" 
                               Margin="0,10,0,20"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!--<ui:Button Content="Clear Filters" 
               Appearance="Secondary"
               Icon="{ui:SymbolIcon Dismiss24}"
               Command="{Binding ViewModel.ClearFiltersCommand}"
               HorizontalAlignment="Center"/>-->
                </StackPanel>

            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows per page:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0" 
                           Foreground="Gray"/>

                <ComboBox ItemsSource="{Binding ViewModel.PageSizeOptions}"
                          SelectedItem="{Binding ViewModel.Request.PageSize}"
                          Width="70">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ChangePageSizeCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.TotalCount}" FontWeight="SemiBold"/>
                <TextBlock Text=" items found" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" 
                           Command="{Binding ViewModel.PreviousPageCommand}"
                           IsEnabled="{Binding ViewModel.HasPreviousPage}"
                           Appearance="Secondary"
                           ToolTip="Previous Page"/>

                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>

                    <ui:TextBox x:Name="PageInput"
                                Text="{Binding ViewModel.Request.Page, UpdateSourceTrigger=LostFocus}"
                                Width="70" 
                                HorizontalContentAlignment="Center">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" 
                                        Command="{Binding ViewModel.JumpToPageCommand}"
                                        CommandParameter="{Binding Text, ElementName=PageInput}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <TextBlock Text="of" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding ViewModel.TotalPages}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" 
                           Command="{Binding ViewModel.NextPageCommand}"
                           IsEnabled="{Binding ViewModel.HasNextPage}"
                           Appearance="Secondary"
                           ToolTip="Next Page"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
