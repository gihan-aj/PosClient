<UserControl x:Class="PosClient.Desktop.Features.Inventory.Products.Editor.Tabs.ImagesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Inventory.Products.Editor.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,20,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ui:TextBlock Text="Product Iamges" FontSize="18" FontWeight="SemiBold"/>
                <ui:TextBlock Text="Upload images for the product." 
                  Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Upload Images" 
                       Icon="{ui:SymbolIcon ArrowUpload24}"
                       Appearance="Primary"
                       Command="{Binding ViewModel.UploadImageCommand}"/>
            </StackPanel>

        </Grid>

        <ui:ListView Grid.Row="1"
                 ItemsSource="{Binding ViewModel.CurrentProduct.Images}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="5" Padding="0" Width="150" Height="200">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:Image Grid.Row="0"
                                  Source="{Binding ImageUrl, Converter={StaticResource ImagePathToBitmapConverter}}"
                                  Stretch="UniformToFill"/>

                            <ui:SymbolIcon Symbol="Star24" Filled="True"
                                    Foreground="Gold"
                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisConverter}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"/>

                            <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="5">

                                <ui:Button Command="{Binding DataContext.ViewModel.SetPrimaryImageCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                       CommandParameter="{Binding}"
                                       Icon="{ui:SymbolIcon Star16}"
                                       ToolTip="Set as Primary"
                                       Appearance="Secondary" Margin="2"/>

                                <ui:Button Command="{Binding DataContext.ViewModel.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                       CommandParameter="{Binding}"
                                       Icon="{ui:SymbolIcon Delete16}"
                                       Appearance="Danger" Margin="2"/>

                            </StackPanel>

                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ui:ListView>

        <Border Grid.Row="1" 
            Background="{DynamicResource ControlFillColorDefaultBrush}" 
            Visibility="{Binding ViewModel.CurrentProduct.Images.Count, Converter={StaticResource InverseItemsExistsToVisibilty}}"
            CornerRadius="5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="BoxDismiss24" FontSize="40" Foreground="Gray" Margin="0,0,0,10"/>
                <TextBlock HorizontalAlignment="Center" Text="No images added yet." Foreground="Gray"/>
                <TextBlock HorizontalAlignment="Center" Text="Use 'Upload Images' to add." Foreground="Gray" FontSize="12"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
