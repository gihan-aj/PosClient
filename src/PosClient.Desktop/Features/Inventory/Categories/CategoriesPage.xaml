<Page x:Class="PosClient.Desktop.Features.Inventory.Categories.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Inventory.Categories"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance local:CategoriesViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="CategoriesPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Categories" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" 
                           Appearance="Secondary" 
                           Command="{Binding ViewModel.LoadDataCommand, Mode=OneWay}"
                           ToolTip="Refresh Data"
                           Margin="0,0,10,0" />
            </StackPanel>

            <ui:Button Grid.Column="1" 
                       Content="New Category" 
                       Appearance="Primary" 
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding ViewModel.CreateNewCommand}"
                       Margin="0,0,0,0">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.SelectedCategory}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" 
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        BorderThickness="1"
                        Margin="0,0,0,0" Padding="10">

                    <TreeView x:Name="CategoryTree" 
                              ItemsSource="{Binding ViewModel.CategoryTree}"
                              BorderThickness="0" Background="Transparent">

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel x:Name="TreeItemPanel"
                                            Tag="{Binding DataContext.ViewModel, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Orientation="Horizontal" Margin="0,5">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Activate" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleStatusFromMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                            <MenuItem Header="Deactivate" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleStatusFromMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <ui:SymbolIcon x:Name="FolderIcon" 
                                                   Symbol="Folder24" 
                                                   FontSize="18"
                                                   Margin="0,0,8,0" 
                                                   Foreground="#E8B931"/>
                                    <TextBlock x:Name="CategoryName" 
                                               Text="{Binding Name}" 
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="TreeItemPanel" Property="Opacity" Value="0.5" />

                                        <Setter TargetName="FolderIcon" Property="Foreground" Value="Gray" />

                                        <Setter TargetName="CategoryName" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectedItemChanged">
                                <b:InvokeCommandAction Command="{Binding ViewModel.LoadCategoryDetailsCommand}"
                                           CommandParameter="{Binding ElementName=CategoryTree, Path=SelectedItem}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                    </TreeView>

                </Border>
            </ScrollViewer>

            <Grid Grid.Column="0" 
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Opacity="0.8"
                  Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisConverter}}">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" 
                                     Width="50" Height="50" />

                    <TextBlock Text="Loading data..." 
                               Margin="0,15,0,0" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="0"
                  Visibility="{Binding ViewModel.IsEmptyResult, Converter={StaticResource BoolToVisConverter}}"
                  IsHitTestVisible="False">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        CornerRadius="8"
                        Opacity="0.8">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">

                        <ui:SymbolIcon Symbol="SearchInfo24" 
                           FontSize="64" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,0,0,20"/>

                        <TextBlock Text="No categories found" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="Try adding a category to get started." 
                                   FontSize="14" 
                                   Margin="0,10,0,20"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    </StackPanel>

                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="10,0,0,0">

                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Opacity="0.6">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.SelectedCategory, Converter={StaticResource IsNotNullConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ui:SymbolIcon Symbol="CursorClick24" FontSize="48" Margin="0,0,0,10" Foreground="Gray"/>
                    <TextBlock Text="Select a category to edit" 
                               FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Foreground="Gray"/>
                    <TextBlock Text="or create a new one" 
                               FontSize="14" 
                               HorizontalAlignment="Center" Foreground="Gray"/>

                    <ui:Button Content="Create New Category" 
                               Icon="{ui:SymbolIcon Add24}" 
                               Appearance="Secondary"
                               Command="{Binding ViewModel.CreateNewCommand}"
                               Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border CornerRadius="8"
                        Padding="10" VerticalAlignment="Top"
                        Background="{DynamicResource ApplicationBackgroundBrush}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.SelectedCategory, Converter={StaticResource IsNotNullConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>

                        <Grid Width="650"
                              HorizontalAlignment="Left">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding ViewModel.SelectedCategory.FormTitle}" 
                                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="Select a category to edit or create new" 
                                           Foreground="Gray" Margin="0,0,0,10" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Name *" VerticalAlignment="Center" Margin="0,0,0,5"/>
                                <ui:TextBox Text="{Binding ViewModel.SelectedCategory.Name, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Required" 
                                            Width="Auto"
                                            Margin="0,0,0,15" />
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Parent" VerticalAlignment="Center" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ViewModel.FlatCategories}"
                                          DisplayMemberPath="NamePath"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ViewModel.SelectedCategory.ParentCategoryId}"
                                          Margin="0,0,0,15"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Description" VerticalAlignment="Top" Margin="0,5,0,5"/>
                                <ui:TextBox Text="{Binding ViewModel.SelectedCategory.Description}" 
                                            Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                            Margin="0,0,0,15" />
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Order" VerticalAlignment="Center" Margin="0,0,0,5"/>
                                <ui:NumberBox Value="{Binding ViewModel.SelectedCategory.DisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                                              Width="100" HorizontalAlignment="Left"
                                              Margin="0,0,0,15"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5">
                                <!--<TextBlock Text="Status" 
                                           Visibility="{Binding ViewModel.SelectedCategory.IsNew, Converter={StaticResource InverseBoolToVisConverter}}"
                                           VerticalAlignment="Center" Margin="0,0,0,5"/>-->
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.SelectedCategory.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Command="{Binding ViewModel.ToggleStatusCommand}"
                                                 CommandParameter="{Binding ViewModel.SelectedCategory}"
                                                 Visibility="{Binding ViewModel.SelectedCategory.IsNew, Converter={StaticResource InverseBoolToVisConverter}}"
                                                 Content="{Binding ViewModel.SelectedCategory.IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}"/>
                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,5" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Delete" Appearance="Danger" Command="{Binding ViewModel.DeleteCommand}" Margin="0,0,5,0"/>
                            <ui:Button Content="Save Changes" Appearance="Primary" Width="150" Command="{Binding ViewModel.SaveCommand}" />
                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

            <Grid Grid.Column="1" 
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Opacity="0.8"
                  Visibility="{Binding ViewModel.IsLoadingDetails, Converter={StaticResource BoolToVisConverter}}">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" 
                                    Width="50" Height="50" />

                    <TextBlock Text="Loading data..." 
                               Margin="0,15,0,0" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

        </Grid>

    </Grid>
</Page>
