<Page x:Class="PosClient.Desktop.Features.Catalog.Categories.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Categories"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      d:DataContext="{d:DesignInstance local:CategoriesViewModel, IsDesignTimeCreatable=False}"
      mc:Ignorable="d" 
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoriesPage">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Categories" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" 
                       Appearance="Secondary" 
                       Command="{Binding ViewModel.LoadDataCommand, Mode=OneWay}"
                       ToolTip="Refresh Data"
                       Margin="0,0,10,0" />
            </StackPanel>

            <ui:Button Grid.Column="1" 
                   Content="New Category" 
                   Appearance="Primary" 
                   Icon="{ui:SymbolIcon Add24}"
                   Command="{Binding ViewModel.CreateNewCommand}"
                   Margin="0,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" 
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">

                <Border 
                    Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,0,10,0" Padding="10">

                
                    <TreeView x:Name="CategoryTree" 
                              ItemsSource="{Binding ViewModel.CategoryTree}"
                              BorderThickness="0" Background="Transparent">

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel x:Name="TreeItemPanel"
                                            Tag="{Binding DataContext.ViewModel, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Orientation="Horizontal" Margin="0,5">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Activate" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleStatusFromMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                            <MenuItem Header="Deactivate" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleStatusFromMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <ui:SymbolIcon x:Name="FolderIcon" 
                                                   Symbol="Folder24" 
                                                   FontSize="18"
                                                   Margin="0,0,8,0" 
                                                   Foreground="#E8B931"/>
                                    <TextBlock x:Name="CategoryName" 
                                               Text="{Binding Name}" 
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="TreeItemPanel" Property="Opacity" Value="0.5" />

                                        <Setter TargetName="FolderIcon" Property="Foreground" Value="Gray" />

                                        <Setter TargetName="CategoryName" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectedItemChanged">
                                <b:InvokeCommandAction Command="{Binding ViewModel.LoadCategoryDetailsCommand}"
                                                       CommandParameter="{Binding ElementName=CategoryTree, Path=SelectedItem}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                    </TreeView>

                </Border>
            </ScrollViewer>

            <Border Grid.Column="1"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
                CornerRadius="8" 
                Padding="20" VerticalAlignment="Top">

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.SelectedCategory}" Value="x:Null">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding ViewModel.SelectedCategory.FormTitle}" 
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="Select a category to edit or create new" 
                   Foreground="Gray" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name *" VerticalAlignment="Center" Margin="0,0,0,15" Grid.Row="0"/>
                        <ui:TextBox Text="{Binding ViewModel.SelectedCategory.Name, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Required" Margin="0,0,0,15" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Parent" VerticalAlignment="Center" Margin="0,0,0,15" Grid.Row="1"/>
                        <ComboBox ItemsSource="{Binding ViewModel.FlatCategories}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ViewModel.SelectedCategory.ParentCategoryId}"
                                  Margin="0,0,0,15" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Description" VerticalAlignment="Top" Margin="0,5,0,15" Grid.Row="2"/>
                        <ui:TextBox Text="{Binding ViewModel.SelectedCategory.Description}" 
                                    Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                    Margin="0,0,0,15" Grid.Row="2" Grid.Column="1" />

                        <TextBlock Text="Order" VerticalAlignment="Center" Margin="0,0,0,15" Grid.Row="3"/>
                        <ui:NumberBox Value="{Binding ViewModel.SelectedCategory.DisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                                      Width="100" HorizontalAlignment="Left"
                                      Margin="0,0,0,15" Grid.Row="3" Grid.Column="1" />

                        <TextBlock Text="Status" 
                                   Visibility="{Binding ViewModel.SelectedCategory.IsNew, Converter={StaticResource InverseBoolToVisConverter}}"
                                   VerticalAlignment="Center" Margin="0,0,0,15" Grid.Row="4"/>
                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.SelectedCategory.IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Command="{Binding ViewModel.ToggleStatusCommand}"
                                         CommandParameter="{Binding ViewModel.SelectedCategory}"
                                         Visibility="{Binding ViewModel.SelectedCategory.IsNew, Converter={StaticResource InverseBoolToVisConverter}}"
                                         Content="{Binding ViewModel.SelectedCategory.IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}"
                                         Grid.Row="4" Grid.Column="1" />
                    </Grid>

                    <Separator Margin="0,10" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Delete" Appearance="Danger" Command="{Binding ViewModel.DeleteCommand}" Margin="0,0,5,0"/>
                        <ui:Button Content="Save Changes" Appearance="Primary" Width="150" Command="{Binding ViewModel.SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>


        </Grid>
    </Grid>
</Page>
