<Page x:Class="PosClient.Desktop.Features.Catalog.Products.Viewer.ProductViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Products.Viewer"
      d:DataContext="{d:DesignInstance local:ProductViewerViewModel, IsDesignTimeCreatable=False}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductViewerPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">

            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                       Appearance="Secondary"
                       Command="{Binding ViewModel.NavigateBackCommand}"
                       ToolTip="Back to List" Margin="0,0,15,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Edit Product"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.EditProductCommand}"
                           CommandParameter="{Binding ViewModel.Product}"/>
                
                <ui:Button Appearance="Danger"
                           Content="Deactivate"
                           Command="{Binding ViewModel.ToggleStatusCommand}"
                           CommandParameter="{Binding ViewModel.Product}"
                           Margin="5,0">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <ui:SymbolIcon Symbol="Power24" FontSize="16"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.Product.IsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <!-- Activate Button (shown when IsActive = False) -->
                <ui:Button Appearance="Success"
                           Content="Activate"
                           Command="{Binding ViewModel.ToggleStatusCommand}"
                           CommandParameter="{Binding ViewModel.Product}"
                           Margin="5,0">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.Product.IsActive}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>

        </Grid>

        <ui:Card Grid.Row="1" >
            <Grid>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <ui:Card Padding="0" Margin="0,0,10,10" Height="300">
                        <Image Source="{Binding ViewModel.Product.PrimaryImage.ImageUrl}" Stretch="UniformToFill"/>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding ViewModel.Product.SecondaryImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="0" Margin="0,0,8,0" Width="60" Height="60">
                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ViewModel.Product.Name}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ViewModel.Product.Sku, StringFormat='SKU: {0}'}" Foreground="Gray" Margin="0,2,0,10"/>

                    <ui:Badge Content="Active" Appearance="Success" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,40,0">
                            <TextBlock Text="Category" FontWeight="SemiBold" Foreground="Gray"/>
                            <TextBlock Text="{Binding ViewModel.Product.CategoryName}" Margin="0,0,0,10"/>

                            <TextBlock Text="Brand" FontWeight="SemiBold" Foreground="Gray"/>
                            <TextBlock Text="{Binding ViewModel.Product.Brand, TargetNullValue='N/A'}" Margin="0,0,0,10"/>

                            <TextBlock Text="Material" FontWeight="SemiBold" Foreground="Gray"/>
                            <TextBlock Text="{Binding ViewModel.Product.Material, TargetNullValue='N/A'}" Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Base Price" FontWeight="SemiBold" Foreground="Gray"/>
                            <TextBlock Text="{Binding ViewModel.Product.BasePrice, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" />

                            <TextBlock Text="Tags" FontWeight="SemiBold" Foreground="Gray" Margin="0,10,0,5"/>
                            <ItemsControl ItemsSource="{Binding ViewModel.Product.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                            <TextBlock Text="{Binding}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        
                    </Grid>

                    <TextBlock Text="Description" FontWeight="SemiBold" Foreground="Gray" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding ViewModel.Product.Description, TargetNullValue='No description provided.'}" TextWrapping="Wrap"/>

                </StackPanel>

            </Grid> 
        </ui:Card>
        
    </Grid>
</Page>
