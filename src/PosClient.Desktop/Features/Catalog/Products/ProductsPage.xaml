<Page x:Class="PosClient.Desktop.Features.Catalog.Products.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Products"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:ProductsViewModel, IsDesignTimeCreatable=False}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Page.Resources>
        <BitmapImage x:Key="PlaceholderImage" UriSource="/Assets/placeholder.png" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0, 0, 0, 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Products" FontSize="24" FontWeight="SemiBold"/>

            <ui:Button Grid.Column="1"
                   Content="New Product"
                   Icon="{ui:SymbolIcon Add24}"
                   Appearance="Primary"
                   Command="{Binding NavigateToAddCommand}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox PlaceholderText="Search products..."
                        Text="{Binding ViewModel.Request.Search, UpdateSourceTrigger=PropertyChanged}"
                        Width="250" Margin="0,0,10,0">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ViewModel.SearchCommand}"/>
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <CheckBox Grid.Column="1"
                      Content="Include Sub-Categories"
                      IsChecked="{Binding ViewModel.Request.IncludeSubCategories}"
                      Command="{Binding ViewModel.ApplyFiltersCommand}"
                      VerticalAlignment="Center"/>

            <ComboBox Grid.Column="3"
                      SelectedIndex="0"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding ViewModel.Request.SortBy}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding ViewModel.SearchCommand}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <ComboBoxItem Content="Newest First" Tag="created"/>
                <ComboBoxItem Content="Name (A-Z)" Tag="name"/>
                <ComboBoxItem Content="Price (Low-High)" Tag="price"/>
            </ComboBox>
        </Grid>

        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding ViewModel.Products}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     SelectionMode="Single">

            <ui:DataGrid.Columns>

                <DataGridTemplateColumn Header="Image" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="50" Height="50" CornerRadius="4" 
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ui:ImageIcon Source="{Binding PrimaryImageUrl, TargetNullValue={StaticResource PlaceholderImage}}" 
                                      Width="50" Height="50"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Product" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150"/>

                <DataGridTextColumn Header="Price" Binding="{Binding BasePrice, StringFormat=N2}" Width="100"/>

                <!--<DataGridTextColumn Header="Stock" Binding="{Binding TotalStock}" Width="80"/>-->

                <DataGridTemplateColumn Header="Stock" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding TotalStock}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding VariantCount, StringFormat='{}{0} variants'}" 
                                       FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                <Border Background="{Binding StockStatusBar}" 
                                    Height="4" CornerRadius="2" Width="40" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#10FF0000"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#1000FF00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}" 
                                       FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </ui:DataGrid.Columns>
            
        </ui:DataGrid>

        <Grid Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.8"
          Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ui:ProgressRing IsIndeterminate="True"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total Items: " Foreground="Gray"/>
                <TextBlock Text="{Binding ViewModel.TotalCount}" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" 
                       Command="{Binding ViewModel.PreviousPageCommand}"
                       IsEnabled="{Binding ViewModel.HasPreviousPage}"
                       Appearance="Secondary"/>

                <TextBlock Text="{Binding ViewModel.Request.Page}" 
                       VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Text="/" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ViewModel.TotalPages}" 
                       VerticalAlignment="Center" Margin="10,0"/>

                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" 
                       Command="{Binding ViewModel.NextPageCommand}"
                       IsEnabled="{Binding ViewModel.HasNextPage}"
                       Appearance="Secondary"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
