<Page x:Class="PosClient.Desktop.Features.Catalog.Products.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Products"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:ProductsViewModel, IsDesignTimeCreatable=False}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Page.Resources>
        <BitmapImage x:Key="PlaceholderImage" UriSource="/Assets/placeholder.png" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0, 0, 0, 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Products" FontSize="24" FontWeight="SemiBold"/>

            <ui:Button Grid.Column="1"
                   Content="New Product"
                   Icon="{ui:SymbolIcon Add24}"
                   Appearance="Primary"
                   Command="{Binding ViewModel.NavigateToAddCommand}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <ComboBox x:Name="SearchInCombo" Grid.Column="0" 
                  ItemsSource="{Binding ViewModel.SearchScopeList}"
                  SelectedItem="{Binding ViewModel.Request.SearchIn}"
                  Width="110" Margin="0,0,10,0"
                  ToolTip="Search In Field"/>

                <TextBlock Text="Search In..."
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ElementName=SearchInCombo, Path=SelectedValue}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ui:TextBox Grid.Column="1" 
                    PlaceholderText="Search products..." 
                    Text="{Binding ViewModel.Request.Search, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,10,0">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ViewModel.SearchCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:Button Grid.Column="2"
                           Height="36"
                           Icon="{ui:SymbolIcon Search24}"
                           Appearance="Primary"
                           Command="{Binding ViewModel.SearchCommand}"/>
            </Grid>


            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CategoryCombo" 
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Grid.Column="0" 
                          Width="250"
                          ItemsSource="{Binding ViewModel.Categories}"
                          DisplayMemberPath="NamePath" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ViewModel.Request.CategoryId}"
                          ToolTip="Filter by Category"
                          Margin="0,0,15,0">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.SearchCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>

                <TextBlock Text="Filter by Category"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=CategoryCombo, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ElementName=CategoryCombo, Path=SelectedValue}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox Grid.Column="1" 
                          Content="Include sub-categories" 
                          IsChecked="{Binding ViewModel.Request.IncludeSubCategories}"
                          Command="{Binding ViewModel.ApplyFilterCommand}"
                          IsEnabled="{Binding ViewModel.Request.CategoryId, Converter={StaticResource IsNotNullConverter}}"
                          VerticalAlignment="Center"/>

                <ComboBox Grid.Column="3"
                          Width="140"
                          ItemsSource="{Binding ViewModel.StatusOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding ViewModel.Request.IsActive}"
                          Margin="15,0,0,0">

                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.SearchCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>

                <ui:Button Grid.Column="4"
                           Height="36"
                           Content="Reset Filters"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Appearance="Secondary"
                           Command="{Binding ViewModel.ClearFiltersCommand}"/>
            </Grid>
        </Grid>

        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding ViewModel.Products}"
                     AutoGenerateColumns="False"
                     HeadersVisibility="Column"
                     CanUserAddRows="False"
                     BorderThickness="1"
                     SelectionMode="Single"
                     Sorting="DataGrid_Sorting"
                     BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">

            <ui:DataGrid.Columns>

                <DataGridTemplateColumn Header="Image" 
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="50" Height="50" CornerRadius="4" 
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center">
                                <ui:ImageIcon Source="{Binding PrimaryImageUrl, TargetNullValue={StaticResource PlaceholderImage}}" 
                                      Width="50" Height="50"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Product" 
                                        Width="*" MinWidth="180"
                                        SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Category" 
                                    Binding="{Binding CategoryName}"
                                    Width="*" MinWidth="100"/>

                <DataGridTextColumn Header="Price" 
                                    Binding="{Binding BasePrice, StringFormat='Rs. {0:N2}'}" 
                                    Width="100"/>

                <!--<DataGridTextColumn Header="Stock" Binding="{Binding TotalStock}" Width="80"/>-->

                <DataGridTemplateColumn Header="Stock" 
                                        Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding TotalStock}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding VariantCount, StringFormat='{}{0} variants'}" 
                                       FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                <Border Background="{Binding StockStatusBar}" 
                                    Height="4" CornerRadius="2" Width="40" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="IsActive">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#10FF0000"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#1000FF00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Active|Inactive'}" 
                                       FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Icon="{ui:SymbolIcon MoreVertical24}" 
                                       Appearance="Transparent"
                                       ToolTip="Actions" Margin="10,0,0,0"
                                       Click="OpenMenu_Click"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">

                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        
                                        <MenuItem Header="Edit Details">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="16"/>
                                            </MenuItem.Icon>

                                            <MenuItem.Command>
                                                <Binding Path="PlacementTarget.Tag.ViewModel.EditProductCommand"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.Command>

                                            <MenuItem.CommandParameter>
                                                <Binding Path="PlacementTarget.DataContext"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.CommandParameter>
                                        </MenuItem>

                                        <Separator/>

                                        <MenuItem>
                                            <MenuItem.Command>
                                                <Binding Path="PlacementTarget.Tag.ViewModel.ToggleStatusCommand"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.Command>

                                            <MenuItem.CommandParameter>
                                                <Binding Path="PlacementTarget.DataContext"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.CommandParameter>

                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="Deactivate"/>
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <ui:SymbolIcon Symbol="Prohibited24" FontSize="16" Foreground="Orange"/>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=CommandParameter.IsActive, RelativeSource={RelativeSource Self}}" Value="False">
                                                            <Setter Property="Header" Value="Activate"/>
                                                            <Setter Property="Icon">
                                                                <Setter.Value>
                                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="Green"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        
                                        <Separator/>

                                        <MenuItem Header="Delete"
                                                  Foreground="Red">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="Red"/>
                                            </MenuItem.Icon>

                                            <MenuItem.Command>
                                                <Binding Path="PlacementTarget.Tag.ViewModel.DeleteProductCommand" 
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.Command>

                                            <MenuItem.CommandParameter>
                                                <Binding Path="PlacementTarget.DataContext" 
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                            </MenuItem.CommandParameter>
                                        </MenuItem>
                                        
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                                
                            </ui:Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </ui:DataGrid.Columns>
            
        </ui:DataGrid>

        <Grid Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.8"
          Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <ui:ProgressRing IsIndeterminate="True"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows per page:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0" 
                   Foreground="Gray"/>

                <ComboBox ItemsSource="{Binding ViewModel.PageSizeOptions}"
                  SelectedItem="{Binding ViewModel.Request.PageSize}"
                  Width="70">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ViewModel.ChangePageSizeCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.TotalCount}" FontWeight="SemiBold"/>
                <TextBlock Text=" items found" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" 
                   Command="{Binding ViewModel.PreviousPageCommand}"
                   IsEnabled="{Binding ViewModel.HasPreviousPage}"
                   Appearance="Secondary"
                   ToolTip="Previous Page"/>

                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>

                    <ui:TextBox x:Name="PageInput"
                        Text="{Binding ViewModel.Request.Page, UpdateSourceTrigger=LostFocus}"
                        Width="70" 
                        HorizontalContentAlignment="Center">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" 
                                Command="{Binding ViewModel.JumpToPageCommand}"
                                CommandParameter="{Binding Text, ElementName=PageInput}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <TextBlock Text="of" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding ViewModel.TotalPages}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" 
                   Command="{Binding ViewModel.NextPageCommand}"
                   IsEnabled="{Binding ViewModel.HasNextPage}"
                   Appearance="Secondary"
                   ToolTip="Next Page"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
