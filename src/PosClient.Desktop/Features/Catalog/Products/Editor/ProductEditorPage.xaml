<Page x:Class="PosClient.Desktop.Features.Catalog.Products.Editor.ProductEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Products.Editor"
      xmlns:tabs="clr-namespace:PosClient.Desktop.Features.Catalog.Products.Editor.Tabs"
      d:DataContext="{d:DesignInstance local:ProductEditorViewModel, IsDesignTimeCreatable=False}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductEditorPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                       Appearance="Secondary"
                       Command="{Binding ViewModel.NavigateBackCommand}"
                       ToolTip="Back to List" Margin="0,0,15,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Text="{Binding ViewModel.IsNew, Converter={StaticResource BoolToStringConverter}, ConverterParameter='New Product|Edit Product'}"
                              FontSize="20" FontWeight="SemiBold"/>

                <ui:TextBlock Text="{Binding ViewModel.CurrentProduct.Sku}"
                              FontFamily="12" Foreground="Gray"
                              Visibility="{Binding ViewModel.IsNew, Converter={StaticResource InverseBoolToVisConverter}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Cancel" 
                           Appearance="Secondary" Margin="0,0,5,0"
                           Command="{Binding ViewModel.NavigateBackCommand}"/>
                <ui:Button Content="Save Product" 
                           Appearance="Primary" 
                           Command="{Binding ViewModel.SaveCommand}" 
                           Icon="{ui:SymbolIcon Save24}"/>
            </StackPanel>
        </Grid>

        <TabControl  Grid.Row="1" Margin="20,0,20,20" Padding="0" >

            <TabItem Header="Basic Info"
                     Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">

                        <Grid Margin="0,20" Width="650" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="Product Name *" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox Text="{Binding ViewModel.CurrentProduct.Name, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. Cotton T-Shirt"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="SKU (Auto-generated if empty)" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox Text="{Binding ViewModel.CurrentProduct.Sku, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="PROD-001"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Category *" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding ViewModel.LeafCategories}"
                                          DisplayMemberPath="NamePath" 
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ViewModel.CurrentProduct.CategoryId}"    
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="Description" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox Text="{Binding ViewModel.CurrentProduct.Description, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Product details..."
                                            TextWrapping="Wrap" 
                                            AcceptsReturn="True" 
                                            Height="80"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="Brand" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox Text="{Binding ViewModel.CurrentProduct.Brand, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Brand Name"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Material" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox Text="{Binding ViewModel.CurrentProduct.Material, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. 100% Cotton"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="Gender" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding ViewModel.GenderOptions}"
                                          SelectedItem="{Binding ViewModel.CurrentProduct.Gender}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Base Price *" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:NumberBox Value="{Binding ViewModel.CurrentProduct.BasePrice, UpdateSourceTrigger=PropertyChanged}"
                                              PlaceholderText="0.00"
                                              Icon="{ui:SymbolIcon Money24}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="Tags" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:TextBox PlaceholderText="Comma separated tags (e.g. Summer, Casual, Sale)"
                                            Icon="{ui:SymbolIcon Tag24}">
                                    <ui:TextBox.Text>
                                        <Binding Path="ViewModel.CurrentProduct.Tags"
                                                 Converter="{StaticResource StringToListConverter}"
                                                 UpdateSourceTrigger="LostFocus"/>
                                    </ui:TextBox.Text>
                                </ui:TextBox>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>

            </TabItem>

            <TabItem Header="Variants"
                     Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <tabs:VariantsTab />
                </Grid>
            </TabItem>
            <!--IsEnabled="{Binding ViewModel.IsNew, Converter={StaticResource BoolToInverseConverter}}"-->
            <TabItem Header="Images"
                     
                     Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <tabs:ImagesTab/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
