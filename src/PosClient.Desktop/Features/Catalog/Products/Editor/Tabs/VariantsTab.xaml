<UserControl x:Class="PosClient.Desktop.Features.Catalog.Products.Editor.Tabs.VariantsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PosClient.Desktop.Features.Catalog.Products.Editor.Tabs"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0, 20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ui:TextBlock Text="Product Variants" FontSize="18" FontWeight="SemiBold"/>
                <ui:TextBlock Text="Manage SKU, pricing, and stock for each variantion." 
                                  Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Add Single" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Secondary"
                               Command="{Binding ViewModel.AddVariantCommand}"/>
                <ui:Button Content="⚡ Quick Generate" 
                               Appearance="Primary" Margin="5,0,0,0"
                               Command="{Binding ViewModel.OpenGeneratorCommand}"/>
            </StackPanel>

        </Grid>

        <ui:DataGrid Grid.Row="1"
                         ItemsSource="{Binding ViewModel.CurrentProduct.Variants}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">

            <ui:DataGrid.Columns>

                <DataGridTemplateColumn Header="SKU" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="(Auto-generate)"
                            BorderThickness="0" 
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Size" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="e.g. XL"
                            BorderThickness="0" 
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Color" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="e.g. Red"
                            BorderThickness="0" 
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Price" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:NumberBox Value="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                              PlaceholderText="0.00"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Stock" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:NumberBox Value="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                              PlaceholderText="0"
                              MaxDecimalPlaces="0"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Transparent" Foreground="Red"
                           ToolTip="Remove Variant"
                           Command="{Binding DataContext.ViewModel.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}"
                           Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </ui:DataGrid.Columns>

        </ui:DataGrid>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    Visibility="{Binding ViewModel.CurrentProduct.Variants.Count, Converter={StaticResource InverseItemsExistsToVisibilty}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="BoxDismiss24" FontSize="40" Foreground="Gray" Margin="0,0,0,10"/>
                <TextBlock Text="No variants added yet." Foreground="Gray"/>
                <TextBlock Text="Use 'Quick Generate' to start." Foreground="Gray" FontSize="12"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
